# SAFENET AI — Environment Configuration Example

# Server Port
PORT=3001
NODE_ENV=development

# Persistent Database File Path (Default: data/safenet.db in project root)
DATABASE_PATH=../data/safenet.db

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:5173

# Optional: Google Gemini API Key for dynamic operational triage & explanation
# If omitted or left blank, the application automatically uses its deterministic rule-based triage fallback
GEMINI_API_KEY=
